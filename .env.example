# This is the example config for local dev. You can set each of these at whatever you want. 
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=penguinlog

# With the default user, password, penguinlog config, this is the connection string for python
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/penguinlog
