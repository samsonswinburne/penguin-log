# This is the example config for local dev. You can set each of these at whatever you want. 
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=penguinlog

# Docker Compose passes these values to the backend container as DB_* variables.
# If running FastAPI directly on your host, use a local DATABASE_URL instead:
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/penguinlog
